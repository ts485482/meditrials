<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="meditrials.meditrials.member.dao.MemberDAO">

    <resultMap id="memberResultMap" type="meditrials.meditrials.member.vo.MemberVO">
        <id property="memberNo" column="MEMBER_NO"/>
        <result property="email" column="EMAIL"/>
        <result property="passwordHash" column="PASSWORD_HASH"/>
        <result property="memberName" column="MEMBER_NAME"/>
        <result property="phone" column="PHONE"/>
        <result property="roleCode" column="ROLE_CODE"/>
        <result property="status" column="STATUS"/>
        <result property="createdAt" column="CREATED_AT"/>
        <result property="updatedAt" column="UPDATED_AT"/>
    </resultMap>

    <sql id="memberColumns">
        MEMBER_NO,
        EMAIL,
        PASSWORD_HASH,
        MEMBER_NAME,
        PHONE,
        ROLE_CODE,
        STATUS,
        CREATED_AT,
        UPDATED_AT
    </sql>

    <select id="countMembers" resultType="int">
        SELECT COUNT(*)
          FROM MEMBER
    </select>

    <select id="countByEmail" resultType="int">
        SELECT COUNT(*)
          FROM MEMBER
         WHERE LOWER(EMAIL) = LOWER(#{email})
    </select>

    <select id="selectMemberByNo" resultMap="memberResultMap">
        SELECT <include refid="memberColumns"/>
          FROM MEMBER
         WHERE MEMBER_NO = #{memberNo}
    </select>

    <select id="selectMemberByEmail" resultMap="memberResultMap">
        SELECT <include refid="memberColumns"/>
          FROM MEMBER
         WHERE LOWER(EMAIL) = LOWER(#{email})
    </select>

    <select id="selectLatestMember" resultMap="memberResultMap">
        SELECT *
          FROM (
                SELECT <include refid="memberColumns"/>
                  FROM MEMBER
                 ORDER BY MEMBER_NO DESC
               )
         WHERE ROWNUM = 1
    </select>

    <insert id="insertMember" parameterType="meditrials.meditrials.member.vo.MemberVO">
        <selectKey keyProperty="memberNo" resultType="long" order="BEFORE">
            SELECT SEQ_MEMBER.NEXTVAL FROM DUAL
        </selectKey>
        INSERT INTO MEMBER (
            MEMBER_NO,
            EMAIL,
            PASSWORD_HASH,
            MEMBER_NAME,
            PHONE,
            ROLE_CODE,
            STATUS,
            CREATED_AT,
            UPDATED_AT
        ) VALUES (
            #{memberNo},
            LOWER(#{email}),
            #{passwordHash},
            #{memberName},
            #{phone,jdbcType=VARCHAR},
            #{roleCode},
            #{status},
            SYSDATE,
            NULL
        )
    </insert>

</mapper>
