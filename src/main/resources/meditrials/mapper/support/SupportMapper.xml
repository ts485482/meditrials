<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="meditrials.meditrials.support.dao.SupportDAO">

    <resultMap id="supportNoticeResultMap" type="meditrials.meditrials.support.vo.SupportNoticeVO">
        <id property="noticeNo" column="NOTICE_NO"/>
        <result property="adminMemberNo" column="ADMIN_MEMBER_NO"/>
        <result property="adminName" column="ADMIN_NAME"/>
        <result property="title" column="TITLE"/>
        <result property="content" column="CONTENT"/>
        <result property="pinned" column="IS_PINNED"/>
        <result property="createdAt" column="CREATED_AT"/>
        <result property="updatedAt" column="UPDATED_AT"/>
    </resultMap>

    <sql id="noticeColumns">
        N.NOTICE_NO,
        N.ADMIN_MEMBER_NO,
        M.MEMBER_NAME AS ADMIN_NAME,
        N.TITLE,
        N.CONTENT,
        N.IS_PINNED,
        N.CREATED_AT,
        N.UPDATED_AT
    </sql>

    <select id="selectNoticeList" resultMap="supportNoticeResultMap">
        SELECT *
          FROM (
                SELECT <include refid="noticeColumns"/>
                  FROM NOTICE N
                  JOIN MEMBER M
                    ON M.MEMBER_NO = N.ADMIN_MEMBER_NO
                 <where>
                    <if test="keyword != null and keyword != ''">
                        AND LOWER(N.TITLE) LIKE '%' || LOWER(#{keyword}) || '%'
                    </if>
                 </where>
                 ORDER BY CASE WHEN N.IS_PINNED = 'Y' THEN 0 ELSE 1 END,
                          N.CREATED_AT DESC,
                          N.NOTICE_NO DESC
               )
         WHERE ROWNUM &lt;= #{limit}
    </select>

    <select id="countNoticeList" resultType="int">
        SELECT COUNT(*)
          FROM NOTICE N
         <where>
            <if test="keyword != null and keyword != ''">
                AND LOWER(N.TITLE) LIKE '%' || LOWER(#{keyword}) || '%'
            </if>
         </where>
    </select>

    <select id="selectNoticeByNo" resultMap="supportNoticeResultMap">
        SELECT <include refid="noticeColumns"/>
          FROM NOTICE N
          JOIN MEMBER M
            ON M.MEMBER_NO = N.ADMIN_MEMBER_NO
         WHERE N.NOTICE_NO = #{noticeNo}
    </select>

</mapper>
